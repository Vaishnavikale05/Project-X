# Copy to .env for Docker Compose and fill in local-only values.
# Never reuse development credentials in staging or production.
DJANGO_SECRET_KEY=
# Optional local-only key; blank uses DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production-only: configure after the approved TLS/domain deployment design.
DJANGO_HSTS_SECONDS=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Compose supplies the service host names; local processes may use localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

LOCAL_STORAGE_ROOT=./var/media
AI_SERVICE_PORT=8010
